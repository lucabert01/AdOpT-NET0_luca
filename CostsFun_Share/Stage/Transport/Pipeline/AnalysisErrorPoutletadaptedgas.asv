A = [error_Poutlet_adapted_gas_perc_avg, error_Poutlet_adapted_gas_perc_min, error_Poutlet_adapted_gas_perc_max;
    error_Ecomp_perc_avg, error_Ecomp_perc_min, error_Ecomp_perc_max;
